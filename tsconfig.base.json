{
  "compilerOptions": {
    "baseUrl": ".",
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "paths": {
      "@hadron/lib/*": ["packages/lib/*"],
      "@hadron/error-handler": ["packages/error-handler/index.ts"],
      "@hadron/error-handler/*": ["packages/error-handler/*"],
      "@hadron/auth-handler/*": ["packages/auth-handler/*"],
      "@hadron/imagekit": ["packages/imagekit/index.ts"]
    },
    "customConditions": ["@hadron/source"]
  }
}
