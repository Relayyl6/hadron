<!DOCTYPE html>
<html>
  <head>
    <title>Eshop Activation Email</title>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style type="text/css">
      /* Base */
      body {
        margin: 0;
        padding: 0;
        min-width: 100%;
        font-family: Arial, sans-serif;
        font-size: 16px;
        line-height: 1.5;
        background-color: #fafafa;
        color: #222222;
      }
      a {
        color: #0070f3;
        text-decoration: none;
      }
      h1 {
        font-size: 24px;
        font-weight: 700;
        line-height: 1.25;
        margin-top: 0;
        margin-bottom: 0;
        text-align: center;
      }
      p {
        margin-top: 0;
        margin-bottom: 24px;
      }
      
      /* Layout */
      .email-wrapper {
        max-width: 600px;
        margin: 40px auto; /* Added top/bottom margin to separate from the email client edges */
        background-color: #ffffff;
        border-radius: 8px; /* Smooth corners */
        overflow: hidden;
        border: 1px solid #eaeaea; /* Subtle border */
      }
      .email-header {
        background-color: #0070f3;
        padding: 24px;
        color: #ffffff;
      }
      .email-body {
        padding: 32px 24px;
        background-color: #ffffff;
      }
      .email-footer {
        background-color: #f6f6f6;
        padding: 24px;
        text-align: center;
        border-top: 1px solid #eaeaea;
      }
      .email-footer p {
        font-size: 14px;
        color: #666666; /* Muted text for footer */
        margin-bottom: 0;
      }

      /* Custom OTP Box (New) */
      .otp-box {
        background-color: #f4f4f5;
        border-radius: 6px;
        padding: 16px;
        text-align: center;
        font-size: 32px;
        font-weight: 700;
        letter-spacing: 6px; /* Spaces out the numbers for readability */
        color: #000000;
        margin: 32px 0;
      }

      /* Preheader (New) */
      .preheader {
        display: none;
        max-height: 0px;
        overflow: hidden;
      }
    </style>
  </head>
  <body>
    <div class="preheader">
      Here is your activation code for Hadron. Please verify your account within 5 minutes.
    </div>

    <div class="email-wrapper">
      <div class="email-header">
        <h1>Welcome to Hadron</h1>
      </div>
      
      <div class="email-body">
        <p>Hello <%= name %>,</p>
        <p>
          Thank you for registering with Hadron. To activate your account, please
          use the following activation code:
        </p>
        
        <div class="otp-box">
          <%= otp %>
        </div>
        
        <p>
          Please enter this code on the activation page within the next <strong>5 minutes</strong>.
        </p>
        <p style="font-size: 14px; color: #666;">
          If you did not register for an Hadron account, please ignore this email. Your account will not be created until verified.
        </p>
      </div>

      <div class="email-footer">
        <p>
          If you have any questions, please don't hesitate to contact us at<br>
          <a href="mailto:oseghaleleonard39@gmail.com">support@hadron.com</a>
        </p>
      </div>
    </div>
  </body>
</html>