      "post": {
        "tags": [
          "Auth"
        ],
        "description": "Initiates user registration and sends an OTP.",
        "parameters": [
          {
            "name": "x-forwarded-for",
            "in": "header",
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "description": "Payload for registering a new user",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CustomerRegistrationPayload"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
