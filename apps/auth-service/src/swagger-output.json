  "definitions": {
    "AccountPayload": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "Jane Doe"
        },
        "email": {
          "type": "string",
          "example": "jane@example.com"
        },
        "password": {
          "type": "string",
          "example": "Str0ngP@ssword!"
        },
        "role": {
          "type": "string",
          "example": "CUSTOMER"
        }
      }
    },
    "AddressPayload": {
      "type": "object",
      "properties": {
        "street": {
          "type": "string",
          "example": "12 Market Street"
        },
        "city": {
          "type": "string",
          "example": "Lagos"
        },
        "state": {
          "type": "string",
          "example": "Lagos"
        },
        "country": {
          "type": "string",
          "example": "NG"
        },
        "postalCode": {
          "type": "string",
          "example": "100001"
        }
      }
    },
    "PreferencesPayload": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "example": "NGN"
        },
        "language": {
          "type": "string",
          "example": "en"
        },
        "marketingConsent": {
          "type": "boolean",
          "example": true
        },
        "pushNotifications": {
          "type": "boolean",
          "example": true
        }
      }
    },
    "CustomerProfilePayload": {
      "type": "object",
      "properties": {
        "phoneNumber": {
          "type": "string",
          "example": "+2348012345678"
        },
        "dateOfBirth": {
          "type": "string",
          "example": "1995-08-24"
        },
        "gender": {
          "type": "string",
          "example": "PREFER_NOT_TO_SAY"
        },
        "preferences": {
          "$ref": "#/definitions/PreferencesPayload"
        },
        "address": {
          "$ref": "#/definitions/AddressPayload"
        }
      }
    },
    "PayoutBankDetailsPayload": {
      "type": "object",
      "properties": {
        "bankName": {
          "type": "string",
          "example": "GTBank"
        },
        "accountNumber": {
          "type": "string",
          "example": "0123456789"
        },
        "accountName": {
          "type": "string",
          "example": "Jane Doe Enterprises"
        }
      }
    },
    "SellerProfilePayload": {
      "type": "object",
      "properties": {
        "phoneNumber": {
          "type": "string",
          "example": "+2348012345678"
        },
        "country": {
          "type": "string",
          "example": "NG"
        },
        "businessName": {
          "type": "string",
          "example": "Jane's Boutique"
        },
        "businessType": {
          "type": "string",
          "example": "CORPORATION"
        },
        "taxId": {
          "type": "string",
          "example": "TIN-00234455"
        },
        "storeDescription": {
          "type": "string",
          "example": "Curated fashion and accessories."
        },
        "payoutBankDetails": {
          "$ref": "#/definitions/PayoutBankDetailsPayload"
        }
      }
    },
    "CustomerRegistrationPayload": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "example": "CUSTOMER"
        },
        "account": {
          "$ref": "#/definitions/AccountPayload"
        },
        "customerProfile": {
          "$ref": "#/definitions/CustomerProfilePayload"
        }
      }
    },
    "SellerRegistrationPayload": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "example": "SELLER"
        },
        "account": {
          "$ref": "#/definitions/AccountPayload"
        },
        "sellerProfile": {
          "$ref": "#/definitions/SellerProfilePayload"
        }
      }
    },
    "VerifyOtpPayload": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "example": "jane@example.com"
        },
        "otp": {
          "type": "string",
          "example": "482913"
        }
      }
    },
    "LoginPayload": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "example": "jane@example.com"
        },
        "password": {
          "type": "string",
          "example": "Str0ngP@ssword!"
        }
      }
    },
    "ForgetPasswordPayload": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "example": "jane@example.com"
        }
      }
    },
    "ResetPasswordPayload": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "example": "jane@example.com"
        },
        "newPassword": {
          "type": "string",
          "example": "NewStr0ngP@ssword!"
        }
      }
    },
    "ShopCreatePayload": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "Jane's Boutique"
        },
        "bio": {
          "type": "string",
          "example": "Curated fashion and accessories, sourced ethically."
        },
        "category": {
          "type": "string",
          "example": "Fashion"
        },
        "coverBanner": {
          "type": "string",
          "example": "https://cdn.hadron.com/shops/janes-boutique/banner.jpg"
        },
        "address": {
          "type": "string",
          "example": "12 Market Street, Lagos, NG"
        },
        "opening_hours": {
          "type": "string",
          "example": "Mon–Sat, 9am–6pm"
        },
        "website": {
          "type": "string",
          "example": "https://janesboutique.com"
        },
        "socialLinks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "platform": {
                "type": "string",
                "example": "instagram"
              },
              "url": {
                "type": "string",
                "example": "https://instagram.com/janesboutique"
              }
            }
          }
        }
      }
    },
    "ShopUpdatePayload": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "Jane's Boutique"
