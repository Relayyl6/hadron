<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
  <head>
    <title>Verify your Hadron seller account</title>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="supported-color-schemes" content="light dark" />
    <!--[if mso]>
    <noscript>
      <xml>
        <o:OfficeDocumentSettings>
          <o:PixelsPerInch>96</o:PixelsPerInch>
        </o:OfficeDocumentSettings>
      </xml>
    </noscript>
    <![endif]-->
    <style type="text/css">
      body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
      table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
      img { -ms-interpolation-mode: bicubic; border: 0; outline: none; text-decoration: none; display: block; }
      body { margin: 0; padding: 0; width: 100% !important; height: 100% !important; }

      body, .bg-body { background-color: #f4f4f5; }
      .bg-card { background-color: #ffffff; }

      a { color: #171717; }

      @media only screen and (max-width: 600px) {
        .email-container { width: 100% !important; }
        .fluid-padding { padding-left: 20px !important; padding-right: 20px !important; }
        .otp-digits { font-size: 28px !important; letter-spacing: 8px !important; }
        .h1 { font-size: 20px !important; }
      }

      @media (prefers-color-scheme: dark) {
        .bg-body { background-color: #0a0a0a !important; }
        .bg-card { background-color: #151515 !important; }
        .text-primary { color: #f5f5f5 !important; }
        .text-muted { color: #a1a1aa !important; }
        .border-soft { border-color: #262626 !important; }
        .otp-box { background-color: #1f1f1f !important; border-color: #333333 !important; }
        .badge { background-color: #1f2a1f !important; border-color: #2e4a2e !important; }
      }
    </style>
  </head>
  <body class="bg-body" style="margin:0; padding:0; background-color:#f4f4f5;">
    <!-- Preheader (hidden preview text) -->
    <div style="display:none; max-height:0; overflow:hidden; mso-hide:all; font-size:1px; line-height:1px; color:#f4f4f5;">
      Your Hadron seller verification code is ready — it expires in 5 minutes.
      &#8199;&#8199;&#8199;&#8199;&#8199;&#8199;&#8199;&#8199;&#8199;&#8199;&#8199;&#8199;&#8199;&#8199;&#8199;&#8199;&#8199;&#8199;&#8199;&#8199;&#8199;&#8199;&#8199;&#8199;&#8199;&#8199;&#8199;&#8199;&#8199;&#8199;
    </div>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="bg-body" style="background-color:#f4f4f5;">
      <tr>
        <td align="center" style="padding: 40px 16px;">

          <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" class="email-container bg-card" style="width:600px; max-width:600px; background-color:#ffffff; border-radius:16px; overflow:hidden; border:1px solid #ececec;">

            <!-- Logo / wordmark -->
            <tr>
              <td align="center" style="padding: 32px 24px 8px 24px;">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td style="width:32px; height:32px; background-color:#171717; border-radius:9px; text-align:center; vertical-align:middle;">
                      <span style="color:#ffffff; font-family:Helvetica, Arial, sans-serif; font-size:16px; font-weight:700; line-height:32px;">H</span>
                    </td>
                    <td style="padding-left:10px; font-family:Helvetica, Arial, sans-serif; font-size:16px; font-weight:600; color:#171717;">
                      Hadron
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Seller badge -->
            <tr>
              <td align="center" style="padding: 8px 24px 0 24px;">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0" class="badge" style="background-color:#f0fdf4; border:1px solid #dcfce7; border-radius:999px;">
                  <tr>
                    <td style="padding: 5px 14px; font-family:Helvetica, Arial, sans-serif; font-size:12px; font-weight:600; letter-spacing:0.3px; color:#166534;">
                      SELLER ACCOUNT
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Heading -->
            <tr>
              <td align="center" class="fluid-padding" style="padding: 16px 40px 0 40px;">
                <h1 class="h1 text-primary" style="margin:0; font-family:Helvetica, Arial, sans-serif; font-size:22px; font-weight:700; line-height:1.3; color:#171717; text-align:center;">
                  Verify your email address
                </h1>
              </td>
            </tr>

            <!-- Body -->
            <tr>
              <td class="fluid-padding" style="padding: 20px 40px 8px 40px; font-family:Helvetica, Arial, sans-serif; font-size:15px; line-height:1.6; color:#3f3f46;">
                <p class="text-primary" style="margin:0 0 16px 0; color:#3f3f46;">Hi <%= name %>,</p>
                <p class="text-primary" style="margin:0 0 8px 0; color:#3f3f46;">
                  Thanks for applying to sell on Hadron. Enter the code below to verify your email and start setting up your seller account.
                </p>
              </td>
            </tr>

            <!-- OTP box -->
            <tr>
              <td class="fluid-padding" style="padding: 20px 40px 8px 40px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="otp-box" style="background-color:#f4f4f5; border:1px solid #ececec; border-radius:12px;">
                  <tr>
                    <td align="center" style="padding: 22px 16px;">
                      <span class="otp-digits" style="font-family:'Courier New', Courier, monospace; font-size:34px; font-weight:700; letter-spacing:10px; color:#171717;">
                        <%= otp %>
                      </span>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Expiry notice -->
            <tr>
              <td class="fluid-padding" style="padding: 8px 40px 0 40px; font-family:Helvetica, Arial, sans-serif; font-size:14px; line-height:1.6;">
                <p class="text-muted" style="margin:0 0 24px 0; color:#71717a; text-align:center;">
                  This code expires in <strong style="color:#3f3f46;">5 minutes</strong>.
                </p>
              </td>
            </tr>

            <!-- Divider -->
            <tr>
              <td class="fluid-padding" style="padding: 0 40px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td class="border-soft" style="border-top:1px solid #ececec; font-size:1px; line-height:1px;">&nbsp;</td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- What's next -->
            <tr>
              <td class="fluid-padding" style="padding: 24px 40px 8px 40px; font-family:Helvetica, Arial, sans-serif; font-size:13px; line-height:1.6;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td style="background-color:#fafafa; border-radius:10px; padding:14px 16px;">
                      <p class="text-muted" style="margin:0; color:#71717a;">
                        Once verified, you'll be able to complete payout setup and open your storefront on Hadron.
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Security note -->
            <tr>
              <td class="fluid-padding" style="padding: 8px 40px 32px 40px; font-family:Helvetica, Arial, sans-serif; font-size:13px; line-height:1.6;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td style="background-color:#fafafa; border-radius:10px; padding:14px 16px;">
                      <p class="text-muted" style="margin:0; color:#71717a;">
                        Didn't apply to sell on Hadron? No action is needed — this email can be safely ignored and no account will be created.
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td class="fluid-padding bg-body" style="padding: 24px 40px; background-color:#f9f9f9; border-top:1px solid #ececec; font-family:Helvetica, Arial, sans-serif; font-size:12px; line-height:1.6; text-align:center;">
                <p style="margin:0 0 6px 0; color:#a1a1aa;">
                  Need help? Reach us anytime at
                  <a href="mailto:sellers@hadron.com" style="color:#525252; text-decoration:underline;">sellers@hadron.com</a>
                </p>
                <p style="margin:0; color:#c4c4c8;">
                  &copy; <%= new Date().getFullYear() %> Hadron. All rights reserved.
                </p>
              </td>
            </tr>

          </table>

        </td>
      </tr>
    </table>
  </body>
</html>